# Configuration du Bot Rôles. Copiez ce fichier en `.env` et complétez-le.
#
# Toutes les variables sans valeur par défaut sont obligatoires. Le bot les
# vérifie au démarrage et signale d'un coup tout ce qui manque.
#
# Pour récupérer un identifiant Discord : Paramètres > Avancés > Mode
# développeur, puis clic droit > Copier l'identifiant.

# Jeton du bot, dans le portail développeur Discord > Bot > Reset Token.
DISCORD_TOKEN=

# Serveur sur lequel le bot opère. Une instance = un serveur.
DISCORD_GUILD_ID=

# Rôles autorisés à utiliser les commandes du bot, séparés par des virgules.
MANAGE_ROLE_IDS=

# Emoji posé sous chaque carte accordant un rôle, et sur lequel les membres
# lèvent la main. Unicode (🙋) ou emoji du serveur au format <:nom:identifiant>.
REACTION_EMOJI=🙋

# Fichier de la base. Doit être sur un volume persistant.
DATABASE_PATH=/data/bot.db

# error, warn, info, debug ou trace. `RUST_LOG` prend le pas si défini.
LOG_LEVEL=info

# Propose la commande /forum importer. À passer à false une fois le contenu importé : la commande disparaît au redémarrage suivant. Défaut : true.
ENABLE_IMPORT=true

# Image à déployer. Facultatif : docker-compose.yml a une valeur par défaut.
# Le nom exact est affiché à la fin du job `build` du pipeline.
# BOT_IMAGE=registry.kher.nl/pause-ia/bot-roles:latest
